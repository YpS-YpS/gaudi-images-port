#!/usr/bin/env bash
# gaudi-dash — multi-pane dashboard for this Gaudi3 box.
# Layout:
#   ┌─────────────┬─────────────────┐
#   │   btop      │                 │
#   ├─────────────┤   hl-smi -l 1   │
#   │   htop      │                 │
#   └─────────────┴─────────────────┘
# Usage:
#   gaudi-dash         # create or attach to the dashboard
#   gaudi-dash kill    # tear it down
#
# Inside tmux:
#   Ctrl-b d        detach (session keeps running)
#   Ctrl-b o        cycle panes
#   Ctrl-b arrow    move between panes
#   Ctrl-b z        zoom current pane (toggle)
#   Ctrl-b [        scroll mode (q to exit)

set -eu
SESSION=gaudi-dash

case "${1:-}" in
  kill|stop|down)
    tmux kill-session -t "$SESSION" 2>/dev/null && echo "stopped $SESSION" || echo "no session"
    exit 0
    ;;
esac

if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# Launch each tool directly as the pane's command (no shell wrapping → no send-keys race).
tmux new-session  -d -s "$SESSION" -x 200 -y 50 'btop'
tmux split-window -h -l 55% -t "$SESSION:0" 'hl-smi -l 1'
tmux split-window -v -l 50% -t "$SESSION:0.0" 'htop'

tmux select-pane -t "$SESSION:0.0"
exec tmux attach -t "$SESSION"
