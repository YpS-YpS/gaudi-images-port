#!/usr/bin/env bash
# gaudi-dash — fancy multi-pane dashboard for this Gaudi3 box.
# Layout (full-width stacked so btop always gets >=80 cols; it refuses <80x24):
#   ┌─────────────────────────────────────────────┐
#   │             hl-top  (8× HL-325)             │
#   ├─────────────────────────────────────────────┤
#   │                   btop                       │
#   ├─────────────────────────────────────────────┤
#   │                   htop                       │
#   └─────────────────────────────────────────────┘
# Usage:
#   gaudi-dash         # create or attach to the dashboard
#   gaudi-dash kill    # tear it down
#
# Inside tmux:
#   Ctrl-b d        detach (session keeps running)
#   Ctrl-b o        cycle panes
#   Ctrl-b arrow    move between panes
#   Ctrl-b z        zoom current pane (toggle)
#   Ctrl-b [        scroll mode (q to exit)

set -eu
SESSION=gaudi-dash
HERE="$(cd "$(dirname "$0")" && pwd)"
HL_TOP="${HERE}/hl-top"

case "${1:-}" in
  kill|stop|down)
    tmux kill-session -t "$SESSION" 2>/dev/null && echo "stopped $SESSION" || echo "no session"
    exit 0
    ;;
esac

if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# Full-width STACKED panes (top→bottom: hl-top, btop, htop).
# Why not side-by-side: btop hard-requires an 80x24 terminal and refuses to
# render ("Terminal size too small") below that. A side-by-side split halves the
# width, so on anything under ~162 cols each bottom pane is <80 wide and btop
# blanks. Stacking gives btop the FULL terminal width (>=80 on any real term),
# and we hand it >=24 rows explicitly. hl-top absorbs whatever height is left
# (it degrades gracefully; btop does not).
tmux new-session -d -s "$SESSION" -x 220 -y 60 "$HL_TOP"

# Middle: btop, full width, ~62% of height. PERCENTAGE (not absolute rows) so the
# share survives tmux's proportional resize when a smaller client attaches — an
# absolute `-l 26` gets scaled down below btop's 24-row floor and it blanks.
# btop needs >=24 rows, so a terminal >=~40 rows tall is required for it to render.
tmux split-window -v -l 78% -t "$SESSION:0.0" 'btop'

# Bottom: htop, full width, small slice under btop.
tmux split-window -v -l 20% -t "$SESSION:0.1" 'htop'

# Subtle styling for the tmux status bar so the chrome matches the panels.
# These are global options so they take no target; failures are non-fatal.
tmux set -g status-style "bg=#1a1d24,fg=#8a93a6" 2>/dev/null || true
tmux set -g status-left  " #[fg=#a8d0ff,bold]gaudi-dash#[default] #[fg=#5a637a]│#[default] " 2>/dev/null || true
tmux set -g status-right "#[fg=#5a637a]│ #[fg=#8a93a6]%H:%M:%S " 2>/dev/null || true
tmux set -g status-left-length 40 2>/dev/null || true
tmux set -g pane-border-style "fg=#3a4150" 2>/dev/null || true
tmux set -g pane-active-border-style "fg=#5a8ec9" 2>/dev/null || true

tmux select-pane -t "$SESSION:0.0"
exec tmux attach -t "$SESSION"
